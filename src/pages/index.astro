---
import BaseLayout from "../layouts/BaseLayout.astro";
import StudentCard from "../components/StudentCard.astro";
import data from "../data/data.json";

// data object
const { students } = data;
// variables
const title = 'DESN FMLY SNRS'
---

<BaseLayout title={title}>
  
  <h1> {title} </h1>
  
  <main>

    {students.map((student) => (
      <StudentCard {...student} />
    ))}
  
</main>

</BaseLayout>





<style>
  main {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding: 1rem;
  }

  h1 {
    text-align: center;
    font-size: 8rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 2rem;
    color: white;
  }

  :global(body) {
    background: #222E50;
  }
</style>